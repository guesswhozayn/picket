# Picket Production Environment Settings
PORT=5000
NODE_ENV=production

# Database & Cache
# If using docker-compose, these will point to the respective service names:
MONGO_URI=mongodb://mongodb:27017/picket
REDIS_HOST=redis
REDIS_PORT=6379
# Alternatively, specify a single Redis URL (takes precedence):
# REDIS_URL=redis://default:password@your-redis-host:6379

# JWT Secrets (Change these to strong secrets in production!)
JWT_SECRET=your_jwt_strong_secret_key_here
JWT_REFRESH_SECRET=your_jwt_strong_refresh_secret_key_here

# Frontend Application URL (Used for CORS and Socket.io verification)
FRONTEND_URL=http://localhost

# Third-Party AI Services & Search APIs
# Add your credentials here. In BYOK mode, users can also provide their own keys.
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key
